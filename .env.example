# Google OAuth credentials for Calendar integration
# Create at: console.cloud.google.com > APIs & Services > Credentials > Desktop app
#
# Place this file (renamed to .env) in any of these locations:
#   ~/Library/Application Support/Scribe/.env   (recommended)
#   Current working directory
#   Next to the Scribe executable
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
